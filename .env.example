# ---------------------------------------------------------------------------
# Smoshed environment variables
#
# Copy to .env.local and fill in real values. .env.local is gitignored.
# Never commit real values. Never paste a real value into a chat, a file or a
# bug report. `npm run secrets:scan` checks the tree for accidents.
#
# This file lists every variable the app reads, split into the two kinds that
# behave completely differently:
#
#   Server-only  read by the API, never sent to the browser.
#   VITE_*       inlined into the client bundle at build time, therefore PUBLIC.
#                Anything named VITE_ must be safe for a stranger to read.
# ---------------------------------------------------------------------------


# --- Server-only: database and sessions ------------------------------------

# Neon Postgres pooled connection string. Required.
# Neon console -> smoshed -> Connection Details -> Pooled connection.
#
# This is the owner credential. A deployed app should use a least-privilege
# role instead, with a separate credential reserved for migrations.
DATABASE_URL=

# Signs session cookies and derives the CSRF token hash. Required.
# At least 32 random bytes; treat changing it as signing every user out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# The single account allowed to open Smosh AI settings and the owner routes.
# Must match the email of an existing Smoshed account, case-insensitively.
# Leave empty and every owner-only feature stays closed. There is no flag, no
# role in the database and no way for a user to grant themselves access.
OWNER_EMAIL=


# --- Server-only: Smosh AI providers --------------------------------------
# Tried in this order. A missing key just skips that provider.
# All four are optional, but with none of them set the bot never replies.

GROQ_API_KEY=
NVIDIA_API_KEY=
OLLAMA_API_KEY=
KEENABLE_API_KEY=


# --- Server-only: OAuth sign-in ----------------------------------------------
# Google and Discord OAuth. Both are optional; without them the buttons are
# hidden. Create credentials at:
#   Google: https://console.cloud.google.com/apis/credentials
#   Discord: https://discord.com/developers/applications
#
# Redirect URIs must include:
#   {APP_URL}/api/auth/google/callback
#   {APP_URL}/api/auth/discord/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=


# --- Server-only: password reset delivery ----------------------------------
# Reset links are refused rather than faked when these are absent: the request
# is accepted and silently dropped, so no working link ever lands in browser
# history or server logs. VITE_MAIL_CONFIGURED below tells the browser which
# state it is in, so keep the two in step.

# Resend API key.
RESEND_API_KEY=

# Verified sender, for example "Smoshed <no-reply@yourdomain.com>".
MAIL_FROM=


# --- Server-only: scheduled routes -----------------------------------------
# Bearer secret for the routes a platform timer calls:
#   POST /api/owner/bot/run
#   POST /api/owner/maintenance
#
# A timer has no session, and giving it one would mean storing the owner's
# password where a scheduler can read it. The owner can also trigger these from
# the browser with their own session.
# Leave empty and the bearer path does not exist, so nothing but an owner
# session can reach them. Generate like SESSION_SECRET.
CRON_SECRET=


# --- Server-only: public address -------------------------------------------
# Where people reach this deployment, used for password-reset links and as the
# canonical CORS origin. Optional, and comma-separated when one deployment
# answers on several hostnames, which is what Vercel preview URLs are:
#   APP_URL=https://smoshed.example.com,https://smoshed-abc-x.vercel.app
# The first entry is the canonical one. Defaults to http://localhost:5173.
#
# Cookies are marked Secure whenever any listed URL is https, or when running
# on Vercel or in production, so an unset value cannot quietly ship a session
# cookie without transport protection.
APP_URL=


# --- VITE_*: public, inlined into the client bundle ------------------------
# These are readable by anyone who loads the site. Do not put a credential here.
# All are optional; the legal pages say a detail is still pending rather than
# inventing one, so leaving them empty is honest but not finished.

# Where to send mail about the site, shown on the legal and contact pages.
VITE_CONTACT_EMAIL=

# The person or company running the site.
VITE_OPERATOR_NAME=

# The registered legal entity, if it differs from the operator name.
VITE_LEGAL_ENTITY=

# The governing law or country of operation.
VITE_JURISDICTION=

# Minimum age to hold an account, as a number, for example 16.
VITE_MINIMUM_AGE=

# Date the legal pages were last revised, for example 2026-01-31.
VITE_LEGAL_UPDATED=

# Set to exactly "true" when RESEND_API_KEY and MAIL_FROM are both set on the
# server. The browser uses it to avoid promising a reset email that cannot be
# delivered. Any other value counts as false.
VITE_MAIL_CONFIGURED=


# --- Set by the platform, not by you ---------------------------------------
# VERCEL        "1" on Vercel. Forces Secure cookies.
# NODE_ENV      "production" in a production build. Forces Secure cookies.
