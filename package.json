{
  "name": "smoshed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:census": "tsx scripts/db-census.ts",
    "db:cleanup-tests": "tsx scripts/db-cleanup-tests.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "contrast": "tsx scripts/contrast.ts",
    "secrets:scan": "tsx scripts/scan-secrets.ts",
    "secrets:bundle": "tsx scripts/scan-bundle.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run contrast && npm run secrets:scan",
    "check:e2e": "npm run test:e2e",
    "verify": "npm run check && npm run build && npm run secrets:bundle"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@node-rs/argon2": "2.2.1",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
